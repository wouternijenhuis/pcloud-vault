{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pCloud Vault",
  "version": "0.1.0",
  "identifier": "dev.pcloudvault.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "pCloud Vault", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650, "backgroundColor": "#f7f8fa" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Your private encrypted pCloud client",
    "category": "Utility",
    "copyright": "pCloud Vault contributors",
    "windows": { "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" } }
  }
}
